# ==============================================================================
# Bol Automation Frontend — Environment Variables Template
# Copy this file to .env and configure values for your environment.
# Note: In Vite, variables exposed to the client must begin with VITE_.
# ==============================================================================

# ---- Backend API Endpoint ----
# Base URL of the FastAPI backend (no trailing slash, no /api/v1 prefix)
# Local development default: http://localhost:8002
VITE_API_URL="http://localhost:8002"

# ---- Google OAuth Web Client ID ----
# Used for user authentication and Google Drive/Spreadsheet selector modal.
# Must match backend GOOGLE_CLIENT_ID and have frontend origin in "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID="<google-oauth-client-id>.apps.googleusercontent.com"

# ---- Registration & Signup Control ----
# Controls whether the "Sign Up" option is shown to users on login screen (true | false)
VITE_SIGNUP_AVAILABLE=false
